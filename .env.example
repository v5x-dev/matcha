# VEX Events API
VEX_EVENTS_TOKEN=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Drizzle
DATABASE_URL=file:local.db
# Turso only: set this when DATABASE_URL points at a libsql:// database.
TURSO_AUTH_TOKEN=

# better-auth
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base url the app builds its email links from. Optional, and usually best left empty:
#
#   - locally, and anywhere else it cannot be derived, the origin of the incoming request is used,
#     so a non-default --port, a container hostname or a tunnel all work without being told;
#   - on Vercel production it is the project's production domain, custom domain included;
#   - on a Vercel preview it is that deployment's own url, so previews authenticate against
#     themselves instead of bouncing people to production.
#
# Set it to override that: a custom domain that is not the project's production domain, or a
# non-Vercel host you want links pinned to. No trailing slash. Do NOT set it for all Vercel
# environments — previews would then send their verification links to production.
#
# Two Vercel settings this depends on: "Automatically expose System Environment Variables" has to
# be on (otherwise VERCEL_URL is not readable at runtime and the app logs a warning saying so), and
# deployment protection on previews will make links in preview emails land on the auth wall.
BETTER_AUTH_URL=

# Chat moderation. Comma-separated emails that are always treated as chat admins, regardless of
# the role stored on their account. This is the bootstrap: the first admin promotes everyone else
# from /moderation, so leaving it empty means nobody can reach the moderation tools.
MODERATOR_EMAILS=

# Resend (transactional email). Leave RESEND_API_KEY unset in development: verification
# links are logged to the server console instead of being sent.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. matcha <noreply@example.com>
EMAIL_FROM=

# Where people appeal a mute, or ask what data you hold about them. Shown on /account, /terms and
# /privacy, and in the chat panel to anyone who is muted. Leaving it empty tells them to reply to
# an email from the app instead, which only works if EMAIL_FROM is a monitored address.
SUPPORT_EMAIL=
