# Loaded by vite (and so by vitest) when mode is "test".
#
# The server modules under test import `$lib/server/db`, which refuses to load without a database
# url even though none of these tests open a connection. This keeps `bun run test` working on a
# fresh checkout and in CI, where there is no .env.
DATABASE_URL=file:local.db
BETTER_AUTH_SECRET=test-secret-not-used-for-anything
